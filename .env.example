# Node 24+. Keep .env private and out of Git. npm run setup generates a password.
DASHBOARD_PASSWORD=replace-this-with-a-long-random-password
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# WORKSPACE_DIR=/srv/codex-home/workspaces
APP_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# Linux: bubblewrap (default). Native is for trusted local development only.
# RUNTIME_ISOLATION=bubblewrap
